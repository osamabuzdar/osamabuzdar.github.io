0:{"buildId":"CjGwa43tgvtTeBda9PM2v","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"services":[{"id":"698d87dfcfa056d7560b2ec9","slug":"web-3-decentralized-internet-698d87dfcfa056d7560b2ec9","title":"Web 3 – Decentralized Internet","description":"Web 3 represents the future of the internet, offering decentralized networks, blockchain-based applications, and secure peer-to-peer interactions. This service empowers users with digital ownership, smart contracts, and transparent online ecosystems, reducing reliance on centralized platforms while enhancing privacy and control.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1770883036/c3uvstrvi1hoijafewji.webp","tags":[],"raw":{"_id":"698d87dfcfa056d7560b2ec9","Service":"Web 3 – Decentralized Internet","Description":"Web 3 represents the future of the internet, offering decentralized networks, blockchain-based applications, and secure peer-to-peer interactions. This service empowers users with digital ownership, smart contracts, and transparent online ecosystems, reducing reliance on centralized platforms while enhancing privacy and control.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1770883036/c3uvstrvi1hoijafewji.webp","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1770883277/puvcu3oakgxe5n6intex.png","Sequence":1,"createdAt":"2026-02-12T07:57:19.126Z","updatedAt":"2026-02-12T08:01:18.055Z","__v":0}},{"id":"6960f2a56838d6437704040f","slug":"flutter-development-6960f2a56838d6437704040f","title":"Flutter Development","description":"We provide high-quality Flutter app development services to build fast, beautiful, and cross-platform mobile applications for both Android and iOS from a single codebase. Our solutions are optimized for performance, scalability, and modern user experience.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1767961682/cmhne48q5nmbuedws3ya.png","tags":[],"raw":{"_id":"6960f2a56838d6437704040f","Service":"Flutter Development","Description":"We provide high-quality Flutter app development services to build fast, beautiful, and cross-platform mobile applications for both Android and iOS from a single codebase. Our solutions are optimized for performance, scalability, and modern user experience.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1767961682/cmhne48q5nmbuedws3ya.png","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1767962418/lw5skgnt4gpaacyhapok.jpg","createdAt":"2026-01-09T12:20:53.332Z","updatedAt":"2026-01-12T11:01:05.847Z","__v":0,"Sequence":1}},{"id":"6937f03fb285d27557495647","slug":"web-development-6937f03fb285d27557495647","title":"Web Development","description":"Web development services create fast, secure, and responsive websites tailored to your business needs. From modern UI/UX design to full-stack functionality, we build scalable platforms that enhance user experience, improve brand visibility, and support business growth. Our solutions ensure performance, reliability, and seamless integration across all devices.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1765275359/cliy1brqstapvsoz9pi6.png","tags":[],"raw":{"_id":"6937f03fb285d27557495647","Service":"Web Development","Description":"Web development services create fast, secure, and responsive websites tailored to your business needs. From modern UI/UX design to full-stack functionality, we build scalable platforms that enhance user experience, improve brand visibility, and support business growth. Our solutions ensure performance, reliability, and seamless integration across all devices.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1765275359/cliy1brqstapvsoz9pi6.png","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1765275361/giulp6vexkiq7spp5r7i.webp","createdAt":"2025-12-09T09:47:43.570Z","updatedAt":"2026-01-12T11:01:20.301Z","__v":0,"Sequence":2}},{"id":"6960fd836838d643770408fd","slug":"wordpress-development-and-business-automation-6960fd836838d643770408fd","title":"WordPress Development & Business Automation","description":"We provide WordPress development services to create fast, secure, and fully customizable websites tailored to your business needs. Alongside, we offer business automation solutions to streamline workflows, improve efficiency, and optimize operations for better productivity and growth.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1767964033/cctle1heluvw3vgzfruj.png","tags":[],"raw":{"_id":"6960fd836838d643770408fd","Service":"WordPress Development & Business Automation","Description":"We provide WordPress development services to create fast, secure, and fully customizable websites tailored to your business needs. Alongside, we offer business automation solutions to streamline workflows, improve efficiency, and optimize operations for better productivity and growth.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1767964033/cctle1heluvw3vgzfruj.png","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1767964034/kmdayazme3wwxuswnhg3.png","createdAt":"2026-01-09T13:07:15.316Z","updatedAt":"2026-01-15T11:31:03.014Z","__v":0,"Sequence":3}},{"id":"6964d6ca6838d643770412f5","slug":"digital-marketing-6964d6ca6838d643770412f5","title":"Digital Marketing","description":"We deliver comprehensive digital marketing solutions that help businesses scale, compete, and succeed in today’s digital landscape. Our strategies are data-driven, technology-focused, and aligned with your business objectives to ensure measurable growth and long-term results.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768216264/z0dokl3eyxgra7mfafn9.png","tags":[],"raw":{"_id":"6964d6ca6838d643770412f5","Service":"Digital Marketing","Description":"We deliver comprehensive digital marketing solutions that help businesses scale, compete, and succeed in today’s digital landscape. Our strategies are data-driven, technology-focused, and aligned with your business objectives to ensure measurable growth and long-term results.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768216264/z0dokl3eyxgra7mfafn9.png","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768216265/tvrsl1rg2sgikxsywlgq.jpg","createdAt":"2026-01-12T11:11:06.066Z","updatedAt":"2026-01-15T11:33:51.347Z","__v":0,"Sequence":4}},{"id":"6964f44f6838d64377042135","slug":"graphic-designing-6964f44f6838d64377042135","title":"Graphic Designing","description":"We bridge the gap between complex functionality and user-friendly aesthetics. Whether you are launching a SaaS platform, a mobile app, or a corporate website, our designs are built to convert users and establish market authority.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768223821/ch4qevkzfcefashsn601.png","tags":[],"raw":{"_id":"6964f44f6838d64377042135","Service":"Graphic Designing","Description":"We bridge the gap between complex functionality and user-friendly aesthetics. Whether you are launching a SaaS platform, a mobile app, or a corporate website, our designs are built to convert users and establish market authority.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768223821/ch4qevkzfcefashsn601.png","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768290225/x7bmypfkszdewoprgby9.png","createdAt":"2026-01-12T13:17:03.321Z","updatedAt":"2026-01-15T11:34:10.018Z","__v":0,"Sequence":5}},{"id":"6964eb566838d64377041ce2","slug":"artificial-intelligence-6964eb566838d64377041ce2","title":"Artificial Intelligence","description":"In an era where data is the new oil, Artificial Intelligence is the engine that drives it. We don't just build software we build intelligent ecosystems that learn, adapt, and evolve. Our AI services bridge the gap between complex data and actionable insights, empowering your business to automate the mundane and focus on the monumental.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768221524/bi3uci2wct9n1bwrmscl.jpg","tags":[],"raw":{"_id":"6964eb566838d64377041ce2","Service":"Artificial Intelligence","Description":"In an era where data is the new oil, Artificial Intelligence is the engine that drives it. We don't just build software we build intelligent ecosystems that learn, adapt, and evolve. Our AI services bridge the gap between complex data and actionable insights, empowering your business to automate the mundane and focus on the monumental.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768221524/bi3uci2wct9n1bwrmscl.jpg","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768221525/lmza87chqn9vtvoedmym.png","createdAt":"2026-01-12T12:38:46.224Z","updatedAt":"2026-01-15T11:35:20.567Z","__v":0,"Sequence":6}},{"id":"6964de096838d643770416df","slug":"cyber-security-6964de096838d643770416df","title":"Cyber Security","description":"Our cyber security services are designed to safeguard your applications, systems, and digital infrastructure from modern cyber threats while ensuring reliability, compliance, and business continuity. We provide end-to-end security solutions tailored to software companies and businesses of all sizes. From secure software development to advanced threat monitoring, our experts identify vulnerabilities, mitigate risks, and implement strong defense mechanisms to protect your digital assets.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768218119/xkwatqff1v7cyw3vmdhx.jpg","tags":[],"raw":{"_id":"6964de096838d643770416df","Service":"Cyber Security","Description":"Our cyber security services are designed to safeguard your applications, systems, and digital infrastructure from modern cyber threats while ensuring reliability, compliance, and business continuity.\r\nWe provide end-to-end security solutions tailored to software companies and businesses of all sizes. From secure software development to advanced threat monitoring, our experts identify vulnerabilities, mitigate risks, and implement strong defense mechanisms to protect your digital assets.","mainImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768218119/xkwatqff1v7cyw3vmdhx.jpg","logoImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768218674/qvdj5tqrcm4xpmgjjt9m.png","createdAt":"2026-01-12T11:42:01.550Z","updatedAt":"2026-01-15T11:35:29.839Z","__v":0,"Sequence":7}}]}],["$L3","$L4","$L5","$L6","$L7","$L8"],"$L9"]}],"isPartial":"$@a","staleTime":"$b","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$b","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$b","varyParams":"$10"},{"rsc":"$L11","isPartial":"$@12","staleTime":"$b","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@13","rootVaryParams":null,"needsRuntimeRequest":"$@14"}
