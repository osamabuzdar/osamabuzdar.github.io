0:{"buildId":"CjGwa43tgvtTeBda9PM2v","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"project":{"id":"6966478e6838d64377047c89","slug":"kids-learning-6966478e6838d64377047c89","title":"kids learning","description":"The Kids Learning App is a mobile educational application designed to provide interactive learning experiences for toddlers and preschoolers. The app focuses on early childhood education by teaching foundational concepts such as alphabets, numbers, colors, shapes, animals, birds, fruits, and vegetables through vibrant visuals, interactive activities, and engaging content. The main goal of the project is to make learning fun, simple, and accessible for young children, while also offering a safe and intuitive interface that prevents accidental exits or confusion. By combining colorful graphics, easy navigation, and educational modules, the app encourages curiosity, cognitive development, and early vocabulary building.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768310668/xpmmouij3dkev90yvjjz.webp","category":"Mobile App","tags":[],"raw":{"_id":"6966478e6838d64377047c89","PImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768310668/xpmmouij3dkev90yvjjz.webp","PName":"kids learning","PDescription":"The Kids Learning App is a mobile educational application designed to provide interactive learning experiences for toddlers and preschoolers. The app focuses on early childhood education by teaching foundational concepts such as alphabets, numbers, colors, shapes, animals, birds, fruits, and vegetables through vibrant visuals, interactive activities, and engaging content.\r\n\r\nThe main goal of the project is to make learning fun, simple, and accessible for young children, while also offering a safe and intuitive interface that prevents accidental exits or confusion. By combining colorful graphics, easy navigation, and educational modules, the app encourages curiosity, cognitive development, and early vocabulary building.","PType":"Mobile App","PLink":"https://u.utrack.com.pk:1985/","clientName":"Bulk Bytes","startDate":"2022-03-01T00:00:00.000Z","endDate":"2022-04-01T00:00:00.000Z","address":"Bulk Bytes","strategyTitle":"Flutter Development","strategyDescription":"This project is built using Flutter and Firebase a modern and efficient technology stack that ensures high performance, real-time data handling, and reliable local data storage.","challengeTitle":"Kid-Friendly Interactive Design","challengeDescription":"Ensuring engaging, age-appropriate content with a simple and safe interface for young children.","clientReview":null,"relatedProjects":[],"createdAt":"2026-01-13T13:24:30.350Z","updatedAt":"2026-01-13T13:24:30.350Z","__v":0}},"relatedProjects":[{"id":"69664bd56838d643770481f2","slug":"ocr-master-image-to-text-69664bd56838d643770481f2","title":"OCR Master Image to Text","description":"The Image to Text app is a mobile utility designed to convert text from images into editable digital text using OCR (Optical Character Recognition) technology. It allows users to take photos of printed or handwritten text, screenshots, receipts, or documents—or select images from the gallery—and automatically extract the text for editing, copying, or sharing. The primary goal of the project is to save time and effort by eliminating manual typing and to provide a fast, reliable, and user-friendly solution for digitizing text. The app targets a wide audience including students, professionals, and everyday users who need to quickly convert image content into usable text for documentation, communication, or productivity purposes.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311764/njbskloubbkvurty9jnx.webp","category":"Mobile App","tags":[],"raw":{"_id":"69664bd56838d643770481f2","PImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311764/njbskloubbkvurty9jnx.webp","PName":"OCR Master Image to Text","PDescription":"The Image to Text app is a mobile utility designed to convert text from images into editable digital text using OCR (Optical Character Recognition) technology. It allows users to take photos of printed or handwritten text, screenshots, receipts, or documents—or select images from the gallery—and automatically extract the text for editing, copying, or sharing.\r\n\r\nThe primary goal of the project is to save time and effort by eliminating manual typing and to provide a fast, reliable, and user-friendly solution for digitizing text. The app targets a wide audience including students, professionals, and everyday users who need to quickly convert image content into usable text for documentation, communication, or productivity purposes.","PType":"Mobile App","PLink":"https://u.utrack.com.pk:1985/","clientName":"Bulk Bytes","projectCategory":"Tool","startDate":"2022-08-01T00:00:00.000Z","endDate":"2022-09-01T00:00:00.000Z","address":"Bulk Bytes","strategyTitle":"Flutter Development","strategyDescription":"This project is built using Flutter and Firebase a modern and efficient technology stack that ensures high performance, real-time data handling, and reliable local data storage.","challengeTitle":"OCR Text Accuracy","challengeDescription":"Ensuring fast and accurate text extraction from images.","clientReview":null,"relatedProjects":[],"createdAt":"2026-01-13T13:42:45.201Z","updatedAt":"2026-01-13T13:42:45.201Z","__v":0}},{"id":"69664adc6838d643770480a3","slug":"smart-dictionary-69664adc6838d643770480a3","title":"Smart Dictionary","description":"The Smart Dictionary app is a mobile educational application designed to help users learn, understand, and use English words effectively. It provides detailed definitions, synonyms, example sentences, parts of speech, and audio pronunciations to support vocabulary building, language comprehension, and proper word usage. The app targets students, writers, professionals, and language learners who need a reliable reference tool for quick word lookup. With a fast search feature, intuitive interface, and no extra downloads required, users can efficiently find the meanings of words and learn correct pronunciation and usage. The app also supports synonyms and example sentences, enabling better understanding and application of words in real-life scenarios.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311516/ndp6saswbtyiolza46mz.webp","category":"Mobile App","tags":[],"raw":{"_id":"69664adc6838d643770480a3","PImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311516/ndp6saswbtyiolza46mz.webp","PName":"Smart Dictionary","PDescription":"The Smart Dictionary app is a mobile educational application designed to help users learn, understand, and use English words effectively. It provides detailed definitions, synonyms, example sentences, parts of speech, and audio pronunciations to support vocabulary building, language comprehension, and proper word usage.\r\n\r\nThe app targets students, writers, professionals, and language learners who need a reliable reference tool for quick word lookup. With a fast search feature, intuitive interface, and no extra downloads required, users can efficiently find the meanings of words and learn correct pronunciation and usage. The app also supports synonyms and example sentences, enabling better understanding and application of words in real-life scenarios.","PType":"Mobile App","PLink":"https://u.utrack.com.pk:1985/","clientName":"Bulk Bytes","projectCategory":"Education","startDate":"2022-06-01T00:00:00.000Z","endDate":"2022-07-01T00:00:00.000Z","address":"Bulk Bytes","strategyTitle":"Flutter Development","strategyDescription":"This project is built using Flutter and Firebase a modern and efficient technology stack that ensures high performance, real-time data handling, and reliable local data storage.","challengeTitle":"Accurate Word Lookup","challengeDescription":"Ensuring fast and accurate word search with definitions and pronunciation.","clientReview":null,"relatedProjects":[],"createdAt":"2026-01-13T13:38:36.545Z","updatedAt":"2026-01-13T13:38:36.545Z","__v":0}}]}],["$L3","$L4","$L5","$L6","$L7"],"$L8"]}],"isPartial":"$@9","staleTime":"$a","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$a","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$a","varyParams":"$f"},{"rsc":"$L10","isPartial":"$@11","staleTime":"$a","varyParams":"$f"},{"rsc":"$L12","isPartial":"$@13","staleTime":"$a","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@14","rootVaryParams":null,"needsRuntimeRequest":"$@15"}
