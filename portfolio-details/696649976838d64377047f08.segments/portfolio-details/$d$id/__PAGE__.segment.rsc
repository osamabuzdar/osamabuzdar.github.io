0:{"buildId":"CjGwa43tgvtTeBda9PM2v","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"project":{"id":"696649976838d64377047f08","slug":"voice-to-text-voice-typing-app-696649976838d64377047f08","title":"Voice to text Voice typing app","description":"The Voice to Text – Voice Typing App is a mobile application designed to convert spoken words into written text in real time, making it easier for users to create notes, messages, or documents without manual typing. Using advanced speech recognition technology, the app accurately transcribes speech into text with support for multiple languages and automatic spacing for readability. The app is aimed at a wide range of users, including students, professionals, content creators, and people with typing difficulties, offering a faster, hands-free, and more convenient way to generate text on mobile devices. Transcribed text can be shared across social media platforms, messaging apps, and other tools, allowing for efficient communication and documentation.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311190/frgs2xgf6uogkwaoq1od.webp","category":"Mobile App","tags":[],"raw":{"_id":"696649976838d64377047f08","PImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311190/frgs2xgf6uogkwaoq1od.webp","PName":"Voice to text Voice typing app","PDescription":"The Voice to Text – Voice Typing App is a mobile application designed to convert spoken words into written text in real time, making it easier for users to create notes, messages, or documents without manual typing. Using advanced speech recognition technology, the app accurately transcribes speech into text with support for multiple languages and automatic spacing for readability.\r\n\r\nThe app is aimed at a wide range of users, including students, professionals, content creators, and people with typing difficulties, offering a faster, hands-free, and more convenient way to generate text on mobile devices. Transcribed text can be shared across social media platforms, messaging apps, and other tools, allowing for efficient communication and documentation.","PType":"Mobile App","PLink":"https://u.utrack.com.pk:1985/","clientName":"Bulk Bytes","projectCategory":"Tool","startDate":"2022-05-01T00:00:00.000Z","endDate":"2022-06-01T00:00:00.000Z","address":"Bulk Bytes","strategyTitle":"Flutter Development","strategyDescription":"This project is built using Flutter and Firebase a modern and efficient technology stack that ensures high performance, real-time data handling, and reliable local data storage.","challengeTitle":"Real-Time Speech Accuracy","challengeDescription":"Ensuring fast and accurate voice-to-text transcription across multiple languages.","clientReview":null,"relatedProjects":[],"createdAt":"2026-01-13T13:33:11.061Z","updatedAt":"2026-01-13T13:33:11.061Z","__v":0}},"relatedProjects":[{"id":"69664bd56838d643770481f2","slug":"ocr-master-image-to-text-69664bd56838d643770481f2","title":"OCR Master Image to Text","description":"The Image to Text app is a mobile utility designed to convert text from images into editable digital text using OCR (Optical Character Recognition) technology. It allows users to take photos of printed or handwritten text, screenshots, receipts, or documents—or select images from the gallery—and automatically extract the text for editing, copying, or sharing. The primary goal of the project is to save time and effort by eliminating manual typing and to provide a fast, reliable, and user-friendly solution for digitizing text. The app targets a wide audience including students, professionals, and everyday users who need to quickly convert image content into usable text for documentation, communication, or productivity purposes.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311764/njbskloubbkvurty9jnx.webp","category":"Mobile App","tags":[],"raw":{"_id":"69664bd56838d643770481f2","PImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311764/njbskloubbkvurty9jnx.webp","PName":"OCR Master Image to Text","PDescription":"The Image to Text app is a mobile utility designed to convert text from images into editable digital text using OCR (Optical Character Recognition) technology. It allows users to take photos of printed or handwritten text, screenshots, receipts, or documents—or select images from the gallery—and automatically extract the text for editing, copying, or sharing.\r\n\r\nThe primary goal of the project is to save time and effort by eliminating manual typing and to provide a fast, reliable, and user-friendly solution for digitizing text. The app targets a wide audience including students, professionals, and everyday users who need to quickly convert image content into usable text for documentation, communication, or productivity purposes.","PType":"Mobile App","PLink":"https://u.utrack.com.pk:1985/","clientName":"Bulk Bytes","projectCategory":"Tool","startDate":"2022-08-01T00:00:00.000Z","endDate":"2022-09-01T00:00:00.000Z","address":"Bulk Bytes","strategyTitle":"Flutter Development","strategyDescription":"This project is built using Flutter and Firebase a modern and efficient technology stack that ensures high performance, real-time data handling, and reliable local data storage.","challengeTitle":"OCR Text Accuracy","challengeDescription":"Ensuring fast and accurate text extraction from images.","clientReview":null,"relatedProjects":[],"createdAt":"2026-01-13T13:42:45.201Z","updatedAt":"2026-01-13T13:42:45.201Z","__v":0}},{"id":"69664adc6838d643770480a3","slug":"smart-dictionary-69664adc6838d643770480a3","title":"Smart Dictionary","description":"The Smart Dictionary app is a mobile educational application designed to help users learn, understand, and use English words effectively. It provides detailed definitions, synonyms, example sentences, parts of speech, and audio pronunciations to support vocabulary building, language comprehension, and proper word usage. The app targets students, writers, professionals, and language learners who need a reliable reference tool for quick word lookup. With a fast search feature, intuitive interface, and no extra downloads required, users can efficiently find the meanings of words and learn correct pronunciation and usage. The app also supports synonyms and example sentences, enabling better understanding and application of words in real-life scenarios.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311516/ndp6saswbtyiolza46mz.webp","category":"Mobile App","tags":[],"raw":{"_id":"69664adc6838d643770480a3","PImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1768311516/ndp6saswbtyiolza46mz.webp","PName":"Smart Dictionary","PDescription":"The Smart Dictionary app is a mobile educational application designed to help users learn, understand, and use English words effectively. It provides detailed definitions, synonyms, example sentences, parts of speech, and audio pronunciations to support vocabulary building, language comprehension, and proper word usage.\r\n\r\nThe app targets students, writers, professionals, and language learners who need a reliable reference tool for quick word lookup. With a fast search feature, intuitive interface, and no extra downloads required, users can efficiently find the meanings of words and learn correct pronunciation and usage. The app also supports synonyms and example sentences, enabling better understanding and application of words in real-life scenarios.","PType":"Mobile App","PLink":"https://u.utrack.com.pk:1985/","clientName":"Bulk Bytes","projectCategory":"Education","startDate":"2022-06-01T00:00:00.000Z","endDate":"2022-07-01T00:00:00.000Z","address":"Bulk Bytes","strategyTitle":"Flutter Development","strategyDescription":"This project is built using Flutter and Firebase a modern and efficient technology stack that ensures high performance, real-time data handling, and reliable local data storage.","challengeTitle":"Accurate Word Lookup","challengeDescription":"Ensuring fast and accurate word search with definitions and pronunciation.","clientReview":null,"relatedProjects":[],"createdAt":"2026-01-13T13:38:36.545Z","updatedAt":"2026-01-13T13:38:36.545Z","__v":0}}]}],["$L3","$L4","$L5","$L6","$L7"],"$L8"]}],"isPartial":"$@9","staleTime":"$a","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$a","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$a","varyParams":"$f"},{"rsc":"$L10","isPartial":"$@11","staleTime":"$a","varyParams":"$f"},{"rsc":"$L12","isPartial":"$@13","staleTime":"$a","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@14","rootVaryParams":null,"needsRuntimeRequest":"$@15"}
