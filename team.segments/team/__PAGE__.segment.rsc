6:["$","div","698c5a12cfa056d7560b27c1",{"className":"w-full transition-transform duration-300 hover:scale-[1.02]","children":["$","$L3",null,{"member":{"id":"698c5a12cfa056d7560b27c1","slug":"muhammad-sohail-698c5a12cfa056d7560b27c1","title":"Muhammad Sohail","description":"I am a Full Stack Developer with over 8 years of professional experience building scalable web applications using Laravel, Node.js, and Vue.js. I specialize in developing secure backend architectures, RESTful APIs, and dynamic front-end interfaces with clean, maintainable code. Over the years, I have worked on enterprise-level systems including HR platforms, workflow automation tools, dashboards, and performance-driven applications. I am comfortable handling complete project lifecycles — from database design and API development to frontend integration and deployment. My focus is always on performance, scalability, and long-term maintainability rather than quick fixes. I can work independently, communicate clearly, and deliver within deadlines. I would be glad to discuss your project requirements and how I can contribute effectively.","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1770806372/sjyluucjvemiylimr7bm.png","category":"Laravel Development","tags":[],"raw":{"_id":"698c5a12cfa056d7560b27c1","MemberImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1770806372/sjyluucjvemiylimr7bm.png","MemberName":"Muhammad Sohail","MemberDesignation":"Senior Full Stack Developer","MemberCoreSkill":"Laravel Development","PhoneNumber":"+923216328470","Email":"sohailmcs87@gmail.com","Description":"I am a Full Stack Developer with over 8 years of professional experience building scalable web applications using Laravel, Node.js, and Vue.js. I specialize in developing secure backend architectures, RESTful APIs, and dynamic front-end interfaces with clean, maintainable code.\r\n\r\nOver the years, I have worked on enterprise-level systems including HR platforms, workflow automation tools, dashboards, and performance-driven applications. I am comfortable handling complete project lifecycles — from database design and API development to frontend integration and deployment.\r\n\r\nMy focus is always on performance, scalability, and long-term maintainability rather than quick fixes. I can work independently, communicate clearly, and deliver within deadlines.\r\n\r\nI would be glad to discuss your project requirements and how I can contribute effectively.","Sequence":4,"createdAt":"2026-02-11T10:29:38.562Z","updatedAt":"2026-02-11T10:41:40.012Z","__v":0,"FbId":null,"GithubId":null,"LinkedinId":null,"PortfolioId":null},"role":"Senior Full Stack Developer","email":"sohailmcs87@gmail.com","phone":"+923216328470"}}]}]
7:["$","div","69736eac220a6eb8356d5b5f",{"className":"w-full transition-transform duration-300 hover:scale-[1.02]","children":["$","$L3",null,{"member":{"id":"69736eac220a6eb8356d5b5f","slug":"muhammad-sajid-nawaz-69736eac220a6eb8356d5b5f","title":"Muhammad Sajid Nawaz","description":"Muhammad Sajid Nawaz is a Sr. Network & DevOps Engineer with extensive experience in enterprise and ISP environments. He specializes in network & system architecture, MikroTik routing, multi-WAN connectivity, security, and system reliability, while leveraging Docker, Linux administration, CI/CD workflows, automation, and infrastructure monitoring to deliver scalable and highly available systems.system administration","image":"http://res.cloudinary.com/df596zrjy/image/upload/v1769172651/fwzftnrsuc2zbsvwv5kq.jpg","category":"Network & data centre Designing deployment configuration","tags":[],"raw":{"_id":"69736eac220a6eb8356d5b5f","MemberImage":"http://res.cloudinary.com/df596zrjy/image/upload/v1769172651/fwzftnrsuc2zbsvwv5kq.jpg","MemberName":"Muhammad Sajid Nawaz","MemberDesignation":"Network & DevOps Engineer","MemberCoreSkill":"Network & data centre Designing deployment configuration","PhoneNumber":"+92 321 3017333","Email":"sajid.nawaz@gmail.com","Description":"Muhammad Sajid Nawaz is a Sr. Network & DevOps Engineer with extensive experience in enterprise and ISP environments. He specializes in network & system architecture, MikroTik routing, multi-WAN connectivity, security, and system reliability, while leveraging Docker, Linux administration, CI/CD workflows, automation, and infrastructure monitoring to deliver scalable and highly available systems.system administration","Sequence":4,"createdAt":"2026-01-23T12:50:52.215Z","updatedAt":"2026-02-17T10:38:39.007Z","__v":0,"FbId":null,"GithubId":null,"LinkedinId":null,"PortfolioId":null},"role":"Network & DevOps Engineer","email":"sajid.nawaz@gmail.com","phone":"+92 321 3017333"}}]}]
